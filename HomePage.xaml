<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:ManagerProduct.Model"
             x:Class="ManagerProduct.HomePage"
             xmlns:scg="clr-namespace:System.Collections.Generic;assembly=netstandard"
             Title="HomePage">
    <VerticalStackLayout>
        <!---
  
  x:Static :      Khi bạn có giá trị tĩnh, cố định, không cần bind thay đổi.
  
                  Thích hợp cho hằng số, màu sắc, chuỗi, enum.
  
                  Không dùng được nếu giá trị cần dynamic, thay đổi theo BindingContext.
  -->
        <!--Binding context.... BindingContext="{x:Reference slider} cho phan tu ben trong"-->
        <StackLayout>
            <Slider x:Name="mySlider" Minimum="0" Maximum="100" />

            <!-- OneWay: chỉ hiển thị giá trị Slider -->
            <Label Text="{Binding Source={x:Reference mySlider}, Path=Value, Mode=OneWay}" />

            <!-- TwoWay: cả Label và Slider đều thay đổi -->
            <Entry Text="{Binding Source={x:Reference mySlider}, Path=Value, Mode=TwoWay}" />

            <!-- OneTime: chỉ lấy giá trị ban đầu của Slider -->
            <Label Text="{Binding Source={x:Reference mySlider}, Path=Value, Mode=OneTime}" />
        </StackLayout>


        <Label Text="ROTATION"
         BindingContext="{x:Reference slider}"
         Rotation="{Binding Path=Value}"
         FontAttributes="Bold"
         FontSize="18"
         HorizontalOptions="Center"
         VerticalOptions="Center" />

        <Slider x:Name="slider"
          Maximum="360"
          VerticalOptions="Center" />
        <Label BindingContext="{x:Reference slider}"
         Text="{Binding Value, StringFormat='The angle is {0:F0} degrees'}"
         FontAttributes="Bold"
         FontSize="18"
         HorizontalOptions="Center"
         VerticalOptions="Center" />
        <Slider x:Name="sliderTest"
      Minimum="0"
      Maximum="100"
      ValueChanged="OnSliderValueChanged"/>
        <Label x:Name="valueLabel" 
     Text="0.000"/>
        <Label Text="Enter a password"  FontSize ="18"/>
        <Entry x:Name="PhoneNumber" Text="1-555-NETMUI" />
        <Button x:Name = "TranlaterButton" 
          Text="Click Me" 
          HeightRequest="{OnPlatform iOS=100, Android=100, WinUI=150}"
          Clicked="Ontranlaster"/>

        <Button x:Name = "CallButton"
          Text = "Call"
          IsEnabled = "False"
          Clicked = "OnCall"/>

        <Button x:Name="BackHome"
          Text="Home"
          Clicked="BackHome_Clicked"/>

        <CollectionView>
            <!-- <x:Array Type="{x:Type model:Monkey}" array tinh>-->
            <CollectionView.ItemsSource>
                <scg:List x:TypeArguments="model:Monkey">
                    <model:Monkey Name="Baboon"
                         Location="Africa and Asia" />
                    <model:Monkey Name="Capuchin Monkey"
                         Location="Central and South America"/>
                    <model:Monkey Name="Blue Monkey"
                         Location="Central and East Africa"/>
                </scg:List>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Monkey">
                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1"
                     Text="{Binding Name}"
                     FontAttributes="Bold" />
                        <Label Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding Location}"
                     FontAttributes="Italic"
                     VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    
</ContentPage>