<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.ProductView"
             xmlns:local="clr-namespace:ManagerProduct.Model"
             Title="Danh sách sản phẩm"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="10">

        <!-- Thanh tìm kiếm -->
        <SearchBar x:Name="ProductSearchBar"
                   Grid.Row="0"
                   Placeholder="Tìm kiếm theo tên hoặc danh mục..."
                   BackgroundColor="White"
                   TextChanged="SearchBar_TextChanged" />

        <!-- Nút thêm -->
        <Button Grid.Row="1"
                Clicked="Add_product"
                Text="➕ Thêm sản phẩm"
                BackgroundColor="#2E86AB"
                TextColor="White"
                CornerRadius="20"
                Padding="12,8"
                FontAttributes="Bold" />

        <!-- Danh sách sản phẩm -->
        <CollectionView x:Name="ProductCollectionView"
                        Grid.Row="2"
                        EmptyView="Chưa có sản phẩm nào trong kho">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Product">
                    <Frame BorderColor="#E0E0E0"
                           CornerRadius="12"
                           Padding="14"
                           Margin="0,0,0,10"
                           HasShadow="True"
                           BackgroundColor="White">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="#222222"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Category, StringFormat='({0})'}" 
                                       FontSize="13" 
                                       TextColor="#888888"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Price, StringFormat='Giá: {0:N0} ₫'}" 
                                   FontSize="15" 
                                   FontAttributes="Bold"
                                   TextColor="#2E86AB"/>
                            <Label Text="{Binding Stock, StringFormat='Tồn kho: {0} sản phẩm'}" 
                                   FontSize="13"
                                   TextColor="#555555"/>
                            <Label Text="{Binding Description}" 
                                   FontSize="13" 
                                   LineBreakMode="TailTruncation" 
                                   TextColor="#777777"/>

                            <!-- Nút chức năng -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0"
                                        Text="✏ Cập nhật" 
                                        BackgroundColor="#FFA726"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Clicked="Update_page"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1"
                                        Text="🗑 Xóa" 
                                        BackgroundColor="#E53935"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Clicked="Delete_Clicked"
                                        CommandParameter="{Binding Id}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
