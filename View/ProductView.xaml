<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.ProductView"
             xmlns:local="clr-namespace:ManagerProduct.Model"
             Title="Danh sách sản phẩm"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="10" Spacing="10">

        <!-- Thanh tìm kiếm -->
        <SearchBar Placeholder="Tìm kiếm sản phẩm..."
                   BackgroundColor="White"
                   Margin="0,5,0,0"
                   
                   />

        <!-- Nút thêm -->
        <Button Clicked="Add_product"
            Text="➕ Thêm sản phẩm"
                BackgroundColor="#2E86AB"
                TextColor="White"
                CornerRadius="20"
                Padding="12,6"/>

        <!-- Danh sách sản phẩm -->
        <CollectionView x:Name="ProductCollectionView"
                        ItemsSource="{Binding Product}"
                        EmptyView="Chưa có sản phẩm"
                        Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Product">
                    <Frame BorderColor="#DDDDDD"
                           CornerRadius="12"
                           Padding="12"
                           Margin="6"
                           HasShadow="True"
                           BackgroundColor="White">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   FontSize="18"/>
                            <Label Text="{Binding Category}" 
                                   FontSize="14" 
                                   TextColor="Gray"/>
                            <Label Text="{Binding Price, StringFormat='Giá: {0:C}'}" 
                                   FontSize="14" 
                                   TextColor="#2E86AB"/>
                            <Label Text="{Binding Stock, StringFormat='Tồn kho: {0}'}" 
                                   FontSize="14"/>
                            <Label Text="{Binding Description}" 
                                   FontSize="13" 
                                   LineBreakMode="TailTruncation" 
                                   TextColor="DimGray"/>

                            <!-- Nút chức năng -->
                            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                <Button Text="✏ Cập nhật" 
                                        BackgroundColor="#FFA726"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        CommandParameter="{Binding .}"/>
                                <Button Text="🗑 Xóa" 
                                        BackgroundColor="#E53935"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        CommandParameter="{Binding Id}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
