<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.OrderDetail"
             Title="OrderDetail">
    <VerticalStackLayout>
            <Label Text="{Binding CustomerId}" x:Name="CustomerName"/>
        <Label Text="{Binding OrderDate}" x:Name="Date"/>
        <Label Text="{Binding TotalAmount}" x:Name="Totalamount"/>


        <CollectionView x:Name="orderDetail" ItemsSource="{Binding OrderDetails}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="10">
                        <Label Text="{Binding ProductName}" FontSize="16" VerticalOptions="Center" WidthRequest="150"/>
                        <Label Text="{Binding UnitPrice, StringFormat='Price: {0:C}'}" FontSize="16" VerticalOptions="Center" WidthRequest="100"/>
                        <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" FontSize="16" VerticalOptions="Center" WidthRequest="100"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>



    </VerticalStackLayout>
</ContentPage>