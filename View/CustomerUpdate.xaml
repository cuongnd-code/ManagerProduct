<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.CustomerUpdate"
             Title="Cập nhật khách hàng"
             BackgroundColor="#F9F9F9">
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="20">
            <Entry x:Name="CustomerIdEntry" Text="{Binding Id}" IsVisible="False"/>

            <Label Text="Họ và tên (*)" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Name" Text="{Binding Name}" BackgroundColor="White"/>

            <Label Text="Ngày sinh" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <DatePicker x:Name="BirthDate" Date="{Binding BirthDate}" Format="dd/MM/yyyy" MinimumDate="01/01/1900" BackgroundColor="White"/>

            <Label Text="Số điện thoại" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="PhoneNumber" Text="{Binding PhoneNumber}" Keyboard="Telephone" BackgroundColor="White"/>

            <Label Text="Địa chỉ" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Address" Text="{Binding Address}" BackgroundColor="White"/>

            <Label Text="Email" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Email" Text="{Binding Email}" Keyboard="Email" BackgroundColor="White"/>

            <Button x:Name="UpdateButton"
                    Text="Lưu cập nhật"
                    FontAttributes="Bold"
                    BackgroundColor="#00838F"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="12,12"
                    Margin="0,10,0,0"
                    Clicked="UpdateButton_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
