<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.CustomerAdd"
             Title="Thêm khách hàng mới"
             BackgroundColor="#F9F9F9">
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="20">
            <Label Text="Họ và tên (*)" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Name" Placeholder="VD: Nguyễn Văn A..." BackgroundColor="White"/>

            <Label Text="Ngày sinh" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <DatePicker x:Name="BirthDate" Format="dd/MM/yyyy" MinimumDate="01/01/1900" BackgroundColor="White"/>

            <Label Text="Số điện thoại (*)" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="PhoneNumber" Placeholder="VD: 0988123456" Keyboard="Telephone" BackgroundColor="White"/>

            <Label Text="Địa chỉ" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Address" Placeholder="VD: Cầu Giấy, Hà Nội..." BackgroundColor="White"/>

            <Label Text="Email" FontAttributes="Bold" FontSize="14" TextColor="#333333"/>
            <Entry x:Name="Email" Placeholder="VD: email@example.com" Keyboard="Email" BackgroundColor="White"/>

            <Button x:Name="AddButton"
                    Text="Lưu khách hàng"
                    FontAttributes="Bold"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="12,12"
                    Margin="0,10,0,0"
                    Clicked="AddButton_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
