<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.OrderView"
             xmlns:local="clr-namespace:ManagerProduct.Model"
             Title="Quản lý Hóa đơn"
             BackgroundColor="#F5F5F5">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">
        <Button Grid.Row="0"
                Text="➕ Tạo hóa đơn mới"
                BackgroundColor="#007AFF"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="20"
                Padding="12,8"
                Clicked="AddOrderButton_Clicked"/>

        <CollectionView x:Name="OrderCollectionView"
                        Grid.Row="1"
                        EmptyView="Chưa có hóa đơn nào">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Order">
                    <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="14" Margin="0,0,0,10" BackgroundColor="White" HasShadow="True">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding OrderId, StringFormat='Đơn #{0}'}" FontAttributes="Bold" FontSize="16" TextColor="#222222"/>
                                <Label Text="{Binding OrderDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#888888" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding CustomerName, StringFormat='Khách hàng: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#004D40"/>
                            <Label Text="{Binding TotalAmount, StringFormat='Tổng tiền: {0:N0} ₫'}" FontSize="15" FontAttributes="Bold" TextColor="#2E86AB"/>
                            
                            <Button Text="Xem chi tiết"
                                    HorizontalOptions="End"
                                    BackgroundColor="#F0F0F0"
                                    TextColor="#333333"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Padding="14,6"
                                    Clicked="OrderDetaiView"
                                    CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
