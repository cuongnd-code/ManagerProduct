<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.View.CustomerView"
             xmlns:local="clr-namespace:ManagerProduct.Model"
             Title="Danh sách khách hàng"
             BackgroundColor="#F5F5F5">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="10">
        <!-- Search -->
        <SearchBar x:Name="CustomerSearchBar"
                   Grid.Row="0"
                   Placeholder="Tìm kiếm theo tên hoặc SĐT..."
                   BackgroundColor="White"
                   TextChanged="CustomerSearchBar_TextChanged"/>

        <!-- Add Button -->
        <Button Grid.Row="1"
                Text="➕ Thêm khách hàng"
                BackgroundColor="#007AFF"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="20"
                Padding="12,8"
                Clicked="Customer_Add"/>

        <!-- CollectionView -->
        <CollectionView x:Name="CustomerCollectionView"
                        Grid.Row="2"
                        EmptyView="Chưa có khách hàng nào">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Customer">
                    <Frame BackgroundColor="#E0F7FA" 
                           BorderColor="#B2EBF2" 
                           CornerRadius="12" 
                           Padding="14" 
                           Margin="0,0,0,10"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#004D40"/>
                                <Label Text="{Binding BirthDate, StringFormat='({0:dd/MM/yyyy})'}" TextColor="#00796B" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding PhoneNumber, StringFormat='SĐT: {0}'}" FontSize="13" TextColor="#333333"/>
                            <Label Text="{Binding Address, StringFormat='Địa chỉ: {0}'}" FontSize="13" TextColor="#555555"/>
                            <Label Text="{Binding Email, StringFormat='Email: {0}'}" FontSize="13" TextColor="#555555"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0"
                                        Text="✏ Cập nhật" 
                                        BackgroundColor="#00838F"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Clicked="Update_Customer"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1"
                                        Text="🗑 Xóa" 
                                        BackgroundColor="#D32F2F"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Clicked="Delete_Customer"
                                        CommandParameter="{Binding Id}"/>  
                            </Grid>
                        </VerticalStackLayout> 
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
