<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.MainPage"
             Title="Tổng quan"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Header Banner -->
            <Frame BackgroundColor="#1E293B" CornerRadius="16" Padding="16" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hệ thống Quản lý Bán hàng" FontAttributes="Bold" FontSize="18" TextColor="White"/>
                    <Label Text="Quản lý kho hàng, khách hàng &amp; hóa đơn nội bộ (SQLite)" FontSize="13" TextColor="#94A3B8"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Dashboard Stats Cards -->
            <Label Text="Thống kê hệ thống" FontAttributes="Bold" FontSize="16" TextColor="#333333"/>
            
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <!-- Products Card -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="📦 Sản phẩm" FontSize="13" TextColor="#64748B" FontAttributes="Bold"/>
                        <Label x:Name="TotalProductsLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label x:Name="LowStockLabel" Text="Hết hàng: 0" FontSize="11" TextColor="#EF4444"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Customers Card -->
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="👥 Khách hàng" FontSize="13" TextColor="#64748B" FontAttributes="Bold"/>
                        <Label x:Name="TotalCustomersLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Đã đăng ký" FontSize="11" TextColor="#10B981"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Orders Card -->
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🧾 Hóa đơn" FontSize="13" TextColor="#64748B" FontAttributes="Bold"/>
                        <Label x:Name="TotalOrdersLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Đã hoàn thành" FontSize="11" TextColor="#3B82F6"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Revenue Card -->
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💰 Doanh thu" FontSize="13" TextColor="#64748B" FontAttributes="Bold"/>
                        <Label x:Name="TotalRevenueLabel" Text="0 ₫" FontSize="16" FontAttributes="Bold" TextColor="#059669" LineBreakMode="TailTruncation"/>
                        <Label Text="Tổng thực thu" FontSize="11" TextColor="#059669"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Quick Action Shortcuts -->
            <Label Text="Thao tác nhanh" FontAttributes="Bold" FontSize="16" TextColor="#333333" Margin="0,8,0,0"/>

            <Button Text="📦 Quản lý Sản phẩm" 
                    BackgroundColor="#2E86AB" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    Padding="14,12" 
                    Clicked="NavigateProduct_Clicked"/>

            <Button Text="🧾 Quản lý Hóa đơn" 
                    BackgroundColor="#007AFF" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    Padding="14,12" 
                    Clicked="NavigateOrder_Clicked"/>

            <Button Text="👥 Quản lý Khách hàng" 
                    BackgroundColor="#00838F" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    Padding="14,12" 
                    Clicked="NavigateCustomer_Clicked"/>

        </VerticalStackLayout> 
    </ScrollView>
</ContentPage>
