                </Grid.RowDefinitions>


                <Label x:Name="TotalOrder" Grid.Column="0" Grid.Row="0" Text="{Binding a}"/>
                <Label x:Name="TotalRevene" Grid.Column="0" Grid.Row="1" Text="a"/>
                <Label x:Name="a" Grid.Column="0" Grid.Row="2" Text="c"/>
                <Button Grid.Column="0" Grid.Row="1" Text="productList" Clicked="Button_Clicked"/>
                <Button Grid.Column="1" Grid.Row="1" Text="Customer List" Clicked="Button_Clicked1"/>
                <Button Grid.Column="2" Grid.Row="1" Text="Order List" Clicked="OrderButton_Clicked"/>
                <Button Grid.Column="3" Grid.Row="1" Text="zzz" Clicked="OrderButton_Clicked"/>

                
                

            </Grid>
            
           
        </VerticalStackLayout> 
        
        
    </ScrollView>



