<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ManagerProduct.MainPage"
             ControlTemplate="{StaticResource BaseTemplate}"
             >
    <!-- trong scg o tren con co Dictionary ObservableCollection(tu dong thong bao khi du lieu thay doi) HashSet-->
    <?HorizontalStackLayout la ngang?>
